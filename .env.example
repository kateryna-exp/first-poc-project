# Public URL of the deployment. Required in production so packument tarball
# URLs cannot be influenced by request headers.
PUBLIC_BASE_URL=https://your-company-npm.vercel.app
 
# Set AUTH_MODE=token for bearer authentication. Generate a token and hash with:
# npm run token -- developer-a
# Store only SHA-256 hashes here. Give each developer or CI job a different ID.
# AUTH_MODE=token
GATEWAY_TOKEN_HASHES_JSON={"developer-a":"replace-with-64-character-sha256-hex"}

# For a controlled temporary test deployment without gateway tokens, use:
# AUTH_MODE=none
# Never use AUTH_MODE=none on a public production deployment.

# log-only: authenticated clients may request any upstream package except denylist entries.
# allowlist: only custom packages and versions in config/package-policy.json are permitted.
PACKAGE_POLICY_MODE=log-only

UPSTREAM_REGISTRY_URL=https://registry.npmjs.org/

# Optional token used by the gateway when the upstream registry requires auth.
# Never put a developer's gateway token here.
# UPSTREAM_NPM_TOKEN=

# Comma-separated host[:port] values permitted for tarball downloads. Redirects
# are validated too. registry.npmjs.org is the public npm default.
UPSTREAM_TARBALL_HOSTS=registry.npmjs.org

# Optional durable audit sink owned by your company. Every request is always
# emitted as structured JSON to Vercel Runtime Logs; the webhook adds retention.
# AUDIT_WEBHOOK_URL=https://logs.example.internal/npm-events
# AUDIT_WEBHOOK_SECRET=replace-me
# AUDIT_IP_SALT=replace-with-a-random-company-secret

# Local development only. Never enable this on Vercel.
# ALLOW_INSECURE_UPSTREAM=false
